<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="MidnightInkColor">#142537</Color><SolidColorBrush x:Key="MidnightInkBrush" Color="{StaticResource MidnightInkColor}"/>
  <Color x:Key="PorcelainColor">#F4F0E8</Color><SolidColorBrush x:Key="PorcelainBrush" Color="{StaticResource PorcelainColor}"/>
  <Color x:Key="PureWhiteColor">#FFFFFF</Color><SolidColorBrush x:Key="PureWhiteBrush" Color="{StaticResource PureWhiteColor}"/>
  <Color x:Key="AntiqueGoldColor">#B89A62</Color><SolidColorBrush x:Key="AntiqueGoldBrush" Color="{StaticResource AntiqueGoldColor}"/>
  <Color x:Key="MutedTealColor">#587C80</Color><SolidColorBrush x:Key="MutedTealBrush" Color="{StaticResource MutedTealColor}"/>
  <Style TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="{StaticResource MidnightInkBrush}"/></Style>
  <Style TargetType="{x:Type Button}"><Setter Property="Background" Value="{StaticResource MidnightInkBrush}"/><Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MidnightInkBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style TargetType="{x:Type TextBox}"><Setter Property="Background" Value="{StaticResource PureWhiteBrush}"/><Setter Property="Foreground" Value="{StaticResource MidnightInkBrush}"/><Setter Property="CaretBrush" Value="{StaticResource MidnightInkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MutedTealBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6,4"/></Style>
  <Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="{StaticResource MidnightInkBrush}"/><Setter Property="Background" Value="{StaticResource PureWhiteBrush}"/></Style>
  <Style TargetType="{x:Type GroupBox}"><Setter Property="Foreground" Value="{StaticResource MidnightInkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MutedTealBrush}"/></Style>
  <Style TargetType="{x:Type ListBox}"><Setter Property="Background" Value="{StaticResource PureWhiteBrush}"/><Setter Property="Foreground" Value="{StaticResource MidnightInkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MutedTealBrush}"/></Style>
  <Style TargetType="{x:Type ListView}"><Setter Property="Background" Value="{StaticResource PureWhiteBrush}"/><Setter Property="Foreground" Value="{StaticResource MidnightInkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MutedTealBrush}"/></Style>
</ResourceDictionary>

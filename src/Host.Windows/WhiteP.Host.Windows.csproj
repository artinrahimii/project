<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WhiteP.Host.Windows</RootNamespace>
    <AssemblyName>WhiteP.Host.Windows</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <Protobuf Include="../../protocol/whitep/v1/messages.proto" ProtoRoot="../../protocol" GrpcServices="None" />
    <ProjectReference Include="../Shared.Contracts/WhiteP.Shared.Contracts.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WhiteP.Host.Windows</RootNamespace>
    <ApplicationIcon>Assets\WhiteP.ico</ApplicationIcon>
    <AssemblyName>WhiteP.Host.Windows</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Company>Artin Rahimi</Company>
    <Authors>Artin Rahimi</Authors>
    <Product>White-P</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nethermind.Libp2p" Version="1.1.0" />
    <ProjectReference Include="../Host.Domain/WhiteP.Host.Domain.csproj" />
    <ProjectReference Include="../Host.Application/WhiteP.Host.Application.csproj" />
    <ProjectReference Include="../Host.Infrastructure/WhiteP.Host.Infrastructure.csproj" />
    <ProjectReference Include="../Shared.Contracts/WhiteP.Shared.Contracts.csproj" />
    <ProjectReference Include="../Shared.Security/WhiteP.Shared.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Models\Catalog\model-catalog-v1.schema.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\WhiteP.ico" />
  </ItemGroup>
</Project>

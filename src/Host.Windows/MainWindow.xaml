<Window x:Class="WhiteP.Host.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="White-P Local AI Host" Height="850" Width="820" MinHeight="740" MinWidth="680" Closed="MainWindow_Closed">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="White-P — Local AI Host" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Connect to a llama.cpp server running on this computer. Prompts are sent to the configured local endpoint." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
<GroupBox Grid.Row="1" Header="Local backend" Margin="0,20,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Server URL" VerticalAlignment="Center" Margin="0,0,12,8"/><TextBox x:Name="ServerUrl" Grid.Column="1" Text="http://127.0.0.1:8080/" Margin="0,0,12,8" Padding="6"/><Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Padding="16,5" Click="ConnectButton_Click" Margin="0,0,0,8"/>
<TextBlock Grid.Row="1" Text="Model ID" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="ModelId" Grid.Row="1" Grid.Column="1" Text="local-model" Padding="6"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Use the model ID accepted by your server." VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
<TextBlock Grid.Row="2" Text="Engine executable" VerticalAlignment="Center" Margin="0,8,12,0"/><TextBox x:Name="EngineExecutablePath" Grid.Row="2" Grid.Column="1" Padding="6" Margin="0,8,12,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Path to llama-server.exe." VerticalAlignment="Center" Margin="12,8,0,0" TextWrapping="Wrap"/><TextBlock Grid.Row="3" Text="Model file (.gguf)" VerticalAlignment="Center" Margin="0,8,12,0"/><TextBox x:Name="ModelFilePath" Grid.Row="3" Grid.Column="1" Padding="6" Margin="0,8,12,0"/><Button x:Name="StartLocalEngineButton" Grid.Row="3" Grid.Column="2" Content="Start local engine" Padding="10,5" Margin="0,8,0,0" Click="StartLocalEngineButton_Click"/><TextBlock Grid.Row="4" Text="Model memory (GiB)" VerticalAlignment="Center" Margin="0,8,12,0"/><TextBox x:Name="ModelMemoryRequirementGiB" Grid.Row="4" Grid.Column="1" Text="4" Padding="6" Margin="0,8,12,0"/><Button Grid.Row="4" Grid.Column="2" Content="Estimate compatibility" Padding="10,5" Margin="0,8,0,0" Click="EstimateModelCompatibility_Click"/><TextBlock Grid.Row="5" Text="Minimum free disk (GiB)" VerticalAlignment="Center" Margin="0,8,12,0"/><TextBox x:Name="MinimumFreeDiskGiB" Grid.Row="5" Grid.Column="1" Text="1" Padding="6" Margin="0,8,12,0"/><TextBlock Grid.Row="5" Grid.Column="2" Text="Free space on the Windows system drive." VerticalAlignment="Center" Margin="12,8,0,0" TextWrapping="Wrap"/></Grid></GroupBox>
<Border Grid.Row="2" Margin="0,14,0,0" Padding="10" Background="#F1F5F9" CornerRadius="6"><StackPanel><TextBlock x:Name="CpuStatus" AutomationProperties.Name="Detected CPU name and logical processor count" TextWrapping="Wrap"/><TextBlock x:Name="MemoryStatus" AutomationProperties.Name="Detected physical memory totals and availability" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="CapacityStatus" AutomationProperties.Name="Verified host capacity state" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="LocalProcessStatus" AutomationProperties.Name="Local model process status" TextWrapping="Wrap" Margin="0,6,0,0" Text="Local engine process: not started by this app."/><TextBlock x:Name="LifecycleState" Text="Stopped — connect to a local backend." AutomationProperties.Name="Host lifecycle state" TextWrapping="Wrap"/><TextBlock x:Name="NetworkState" AutomationProperties.Name="Local endpoint and peer network status" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="GpuStatus" AutomationProperties.Name="Detected GPU and display adapters" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="BackendCapabilityStatus" AutomationProperties.Name="Local inference backend availability" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="ModelCompatibilityStatus" AutomationProperties.Name="Model memory compatibility estimate" TextWrapping="Wrap" Margin="0,6,0,0" Text="Model compatibility: enter a declared memory requirement and estimate."/></StackPanel></Border>
<Grid Grid.Row="3" Margin="0,20,0,0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<GroupBox Grid.Row="0" Header="Model catalog" Padding="8" Margin="0,0,0,10">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Catalog JSON" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="CatalogFilePath" Grid.Column="1" Padding="5" Margin="0,0,8,6"/><Button x:Name="BrowseCatalogButton" Grid.Column="2" Content="Browse..." Padding="10,4" Margin="0,0,0,6" Click="BrowseCatalogButton_Click"/>
<TextBlock Grid.Row="1" Text="Trusted source hosts" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="CatalogTrustedSourceHosts" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="5" Margin="0,0,0,6" ToolTip="Enter exact hostnames you trust, separated by semicolons. Source URLs must use HTTPS."/>
<TextBlock Grid.Row="2" Text="Trusted license hosts" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="CatalogTrustedLicenseHosts" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Padding="5" Margin="0,0,0,6" ToolTip="Optional. If blank, the source-host allowlist is reused for license URLs."/>
<ListView x:Name="CatalogItems" Grid.Row="3" Grid.ColumnSpan="3" Height="120" Margin="0,3,0,6" SelectionChanged="CatalogItems_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
<ListView.View><GridView><GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/><GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="110"/><GridViewColumn Header="Format" DisplayMemberBinding="{Binding Format}" Width="65"/><GridViewColumn Header="Size (bytes)" DisplayMemberBinding="{Binding SizeBytes}" Width="100"/><GridViewColumn Header="License status" DisplayMemberBinding="{Binding License.Status}" Width="100"/><GridViewColumn Header="Review state" DisplayMemberBinding="{Binding License.ReviewLabel}" Width="190"/></GridView></ListView.View>
</ListView>
<Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2,0,8"><StackPanel><TextBlock Text="Selected model — details and use limitations" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="CatalogModelDetails" Text="Select a model record to inspect its source, license metadata, size, checksum, backend and limitations." TextWrapping="Wrap" AutomationProperties.Name="Selected model details, license, source, size and limitations"/></StackPanel></Border>
<TextBlock x:Name="CatalogStatus" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="No model catalog is bundled. Choose a local JSON catalog and explicitly trust its source hostnames." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="LoadCatalogButton" Grid.Row="5" Grid.Column="2" Content="Load catalog" Padding="10,5" Click="LoadCatalogButton_Click"/>
</Grid>
</GroupBox>
<TextBlock Grid.Row="1" Text="Prompt" FontWeight="SemiBold"/><TextBox x:Name="PromptInput" Grid.Row="2" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,8,0,12"/><TextBox x:Name="OutputText" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
</Grid>
<DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock Text="The backend client does not log prompt/response contents." TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560"/><Button x:Name="GenerateButton" DockPanel.Dock="Right" Content="Generate locally" Padding="18,8" Click="GenerateButton_Click" IsEnabled="False" Margin="12,0,0,0"/><Button x:Name="CancelGenerationButton" DockPanel.Dock="Right" Content="Cancel inference" Padding="12,8" Click="CancelGenerationButton_Click" IsEnabled="False" Margin="12,0,0,0"/></DockPanel>
</Grid></Window>